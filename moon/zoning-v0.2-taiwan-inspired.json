  "strict_use_rules": [
    {
      "rule": "OFFICE_LOCATION",
      "text": "Independent office buildings are permitted only in commercial zones C1-C3. Industrial zones may contain ancillary operational offices only."
    },
    {
      "rule": "INDUSTRIAL_LOCATION",
      "text": "Manufacturing and industrial uses are permitted only in industrial zones I1-I2 unless a special district variance exists."
    },
    {
      "rule": "GROUND_FLOOR_SHOPS",
      "text": "Residential ground-floor shops are allowed only where the R_SHOP_1F frontage overlay is registered."
    },
    {
      "rule": "UNIT_REGISTRY",
      "text": "Every residence, office and shop must have an independent persistent Unit ID and virtual address."
    },
    {
      "rule": "EARTH_VIEW",
      "text": "Registered Earth View corridors are protected across every zone and may further reduce the build envelope."
    },
    {
      "rule": "NO_BUILD_RIGHT_BY_REQUEST",
      "text": "Agent generation requests cannot override zoning, site area, FAR, BCR, height, setback or protected-view constraints."
